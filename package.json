{
  "name": "civts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --reporter=dot",
    "rules:provenance": "tsx packages/headless/src/cli.ts provenance",
    "map": "tsx packages/headless/src/cli.ts map",
    "play": "tsx packages/headless/src/cli.ts play",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "verify:full": "pnpm verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  }
}

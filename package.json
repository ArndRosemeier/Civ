{
  "name": "civts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --cache --cache-location .cache/eslint.cache --cache-strategy content",
    "lint:full": "eslint .",
    "format:check": "prettier --check . --cache --cache-location .cache/prettier.cache",
    "format:check:full": "prettier --check .",
    "check:static": "pnpm typecheck & t=$!; pnpm lint & l=$!; pnpm format:check & f=$!; s=0; wait $t || s=1; wait $l || s=1; wait $f || s=1; exit $s",
    "check:static:full": "pnpm typecheck & t=$!; pnpm lint:full & l=$!; pnpm format:check:full & f=$!; s=0; wait $t || s=1; wait $l || s=1; wait $f || s=1; exit $s",
    "test": "vitest run",
    "test:full": "CIVTS_TEST_TIER=full vitest run",
    "mutation:check": "CIVTS_MUTATION_CHECK=1 vitest run packages/testing/test/m9-m10-adversarial.test.ts --no-file-parallelism",
    "rules:provenance": "tsx packages/headless/src/cli.ts provenance",
    "map": "tsx packages/headless/src/cli.ts map",
    "play": "tsx packages/headless/src/cli.ts play",
    "tournament:evidence": "tsx scripts/tournament-evidence.ts",
    "verify": "pnpm check:static && pnpm test",
    "verify:full": "pnpm check:static:full && pnpm test:full",
    "deploy:sync": "bash deploy-sync.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  }
}
